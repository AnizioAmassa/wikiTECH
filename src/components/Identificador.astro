---
interface Props {
  identificador: string;
  destaque?: boolean;
}
const { identificador, destaque = false } = Astro.props;
const tamanho = destaque ? 40 : 22;
---

<div class:list={['identificador', { destaque }]}>
  <span class="icone" aria-hidden="true">
    <svg width={tamanho} height={tamanho} viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
      <path d="M7.5 13.5 9.5 8.5l2 5M8.2 12h2.6M14 13.5V9.6M14 11.3c.4-.9 1.1-1.4 2-1.3" />
    </svg>
  </span>
  <div class="identificador-texto">
    <span class="identificador-tipo">Identificador</span>
    <span class="identificador-valor">{identificador}</span>
  </div>
</div>
