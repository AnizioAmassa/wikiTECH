---
import type { Pessoa } from '../lib/site';
import { url } from '../lib/site';

interface Props {
  pessoa: Pessoa;
}
const { pessoa } = Astro.props;
const { nome, apelido, turma, enfase } = pessoa.data;
---

<li class="cartao">
  <a href={url(`pessoas/${pessoa.id}/`)} class="cartao-link">
    <strong class="cartao-nome">{nome}</strong>
    {apelido && <span class="cartao-apelido">“{apelido}”</span>}
    <span class="cartao-meta">Turma {turma}{enfase && ` · ${enfase}`}</span>
  </a>
</li>
