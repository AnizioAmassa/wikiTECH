---
import Base from '../layouts/Base.astro';
import Busca from '../components/Busca.astro';
import { ultimasEdicoes, formatarData, url } from '../lib/site';

const edicoes = await ultimasEdicoes();
---

<Base>
  <section class="hero">
    <h1>WikiTECH</h1>
    <p>A wiki <strong>não oficial</strong> feita por alunos do IMPA Tech: pessoas, apelidos, turmas e tudo o que ninguém te contou.</p>
    <p class="hero-aviso">
      Projeto independente dos alunos, sem vínculo com o IMPA. <a href={url('sobre/')}>Sobre</a>
    </p>
  </section>

  <Busca />

  <section class="secao" aria-labelledby="titulo-edicoes">
    <h2 id="titulo-edicoes">Últimas edições</h2>
    <ul class="lista-simples">
      {
        edicoes.map((e) => (
          <li>
            <a href={e.href}>{e.titulo}</a>
            <span class="muted">
              <span class="etiqueta">{e.tipo}</span> · {formatarData(e.data)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="aviso">
    Ainda não tem perfil?
    <a href="https://github.com/AnizioAmassa/wikiTECH/blob/main/CONTRIBUTING.md">Veja como criar o seu</a>.
  </p>
</Base>
