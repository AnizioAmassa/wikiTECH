---
import Base from '../layouts/Base.astro';
import { todasPessoas, comoChamar, url, type Pessoa } from '../lib/site';
import { normalizar } from '../lib/normalizar';

// Só quem escolheu um identificador (ele é opcional).
const pessoas = (await todasPessoas()).filter((p) => p.data.identificador) as (Pessoa & { data: { identificador: string } })[];

// Agrupa por letra inicial (sem acento), em ordem alfabética.
const porLetra = new Map<string, Pessoa[]>();
for (const p of [...pessoas].sort((a, b) => a.data.identificador.localeCompare(b.data.identificador, 'pt-BR'))) {
  const letra = normalizar(p.data.identificador)[0].toUpperCase();
  porLetra.set(letra, [...(porLetra.get(letra) ?? []), p]);
}
const letras = [...porLetra.keys()].sort();

const usados = pessoas.map((p) => normalizar(p.data.identificador));
---

<Base titulo="Identificadores" descricao="Todas as palavras já escolhidas, para você achar uma livre.">
  <h1>Identificadores</h1>
  <p>
    Além do apelido, cada aluno pode escolher uma <strong>palavra única</strong> como identificador. Nenhuma palavra
    pode se repetir, e a comparação ignora maiúsculas e acentos: <em>Girassol</em> e <em>girassól</em> são a mesma.
  </p>

  <section class="secao" aria-labelledby="titulo-verificador">
    <h2 id="titulo-verificador">Está livre?</h2>
    <form class="verificador" data-usados={JSON.stringify(usados)} onsubmit="return false">
      <label for="v-valor">Sua palavra</label>
      <input id="v-valor" name="valor" autocomplete="off" placeholder="ex.: girassol" />
      <p class="verificador-resultado" aria-live="polite"></p>
    </form>
    <p class="muted">
      <small>No build, a palavra também passa por um filtro de obscenidades, que esta caixa não mostra.</small>
    </p>
  </section>

  <section class="secao">
    <h2>Já escolhidas <span class="muted">({pessoas.length})</span></h2>
    {pessoas.length === 0 && <p>Ninguém escolheu ainda. A primeira palavra pode ser sua!</p>}
    <ul class="indice-letras" aria-label="Ir para a letra">
      {letras.map((l) => <li><a href={`#letra-${l}`}>{l}</a></li>)}
    </ul>
    {
      letras.map((l) => (
        <div class="letra" id={`letra-${l}`}>
          <h2>{l}</h2>
          <ul class="lista-simples">
            {porLetra.get(l)!.map((p) => (
              <li>
                <strong>{p.data.identificador}</strong>
                <a href={url(`pessoas/${p.id}/`)}>{comoChamar(p)}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<script>
  import { normalizar, FORMATO_PALAVRA } from '../lib/normalizar';

  const form = document.querySelector<HTMLFormElement>('.verificador')!;
  const usados = new Set<string>(JSON.parse(form.dataset.usados ?? '[]'));
  const valor = form.querySelector<HTMLInputElement>('input')!;
  const resultado = form.querySelector<HTMLParagraphElement>('.verificador-resultado')!;

  valor.addEventListener('input', () => {
    const v = valor.value.trim();
    resultado.className = 'verificador-resultado';
    if (!v) {
      resultado.textContent = '';
      return;
    }
    let ok = false;
    if (!FORMATO_PALAVRA.test(v)) {
      resultado.textContent = '✖ Use uma única palavra, só com letras (hífen permitido).';
    } else if (v.length < 2 || v.length > 30) {
      resultado.textContent = '✖ A palavra deve ter de 2 a 30 letras.';
    } else if (usados.has(normalizar(v))) {
      resultado.textContent = '✖ Já tem dono. Escolha outra.';
    } else {
      ok = true;
      resultado.textContent = '✔ Livre! Corre lá e cria o seu perfil.';
    }
    resultado.classList.add(ok ? 'livre' : 'ocupado');
  });
</script>
