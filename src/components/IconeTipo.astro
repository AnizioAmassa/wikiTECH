---
import type { TipoIdentificador } from '../lib/normalizar';
import { ROTULO_TIPO } from '../lib/normalizar';

interface Props {
  tipo: TipoIdentificador;
  tamanho?: number;
}
const { tipo, tamanho = 24 } = Astro.props;
---

<span class={`icone icone-${tipo}`} title={ROTULO_TIPO[tipo]} aria-hidden="true">
  <svg width={tamanho} height={tamanho} viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {tipo === 'palavra' && (
      <>
        <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
        <path d="M7.5 13.5 9.5 8.5l2 5M8.2 12h2.6M14 13.5V9.6M14 11.3c.4-.9 1.1-1.4 2-1.3" />
      </>
    )}
    {tipo === 'primo' && (
      <>
        <path d="M8 20V4h5.5a4 4 0 0 1 0 8H8" />
        <path d="M11 4v16" />
        <path d="M5 20h9" />
      </>
    )}
    {tipo === 'patrono' && (
      <>
        <circle cx="12" cy="8" r="3.5" />
        <path d="M5 20c.6-3.6 3.4-6 7-6s6.4 2.4 7 6" />
        <path d="M6.5 6.5C5.5 4.8 6 3 6 3M17.5 6.5c1-1.7.5-3.5.5-3.5" />
      </>
    )}
    {tipo === 'objeto' && (
      <>
        <ellipse cx="12" cy="12" rx="9.5" ry="5.5" />
        <path d="M7.5 11.5c2.5 2 6.5 2 9 0" />
        <path d="M8.8 12.6c2-1.3 4.4-1.3 6.4 0" />
      </>
    )}
  </svg>
</span>
